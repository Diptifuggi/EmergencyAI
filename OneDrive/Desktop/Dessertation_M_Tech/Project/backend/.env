APP_NAME=EmergencyIQ
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:DIPTIPATEL@localhost:5432/emergencyiq_db
SECRET_KEY=supersecretplaceholder
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_UPLOAD_SIZE_MB=50
ALLOWED_AUDIO_EXTENSIONS=.wav,.mp3,.m4a,.mp4,.ogg,.aac,.webm
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000,http://10.0.2.2:8000,*
AUDIO_EVENT_DETECTOR_BACKEND=lightweight_fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_DECODING_MODEL=qwen2.5:0.5b
OLLAMA_ENCODING_MODEL=kimi
NOMINATIM_URL=http://localhost:8080
NOMINATIM_TIMEOUT_SECONDS=2
NOMINATIM_COUNTRY_CODE=in
MAP_TILE_URL=http://localhost:8081/tiles/{z}/{x}/{y}.png
