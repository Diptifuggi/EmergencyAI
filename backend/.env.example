# EmergencyIQ example environment
APP_NAME=EmergencyIQ
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@localhost:5432/emergencyiq_db
SECRET_KEY=replace_this_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_UPLOAD_SIZE_MB=50
ALLOWED_AUDIO_EXTENSIONS=.wav,.mp3,.m4a,.mp4,.ogg,.aac,.webm
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000,http://10.0.2.2:8000
AUDIO_EVENT_DETECTOR_BACKEND=lightweight_fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_DECODING_MODEL=qwen2.5:0.5b
OLLAMA_ENCODING_MODEL=kimi
NOMINATIM_URL=http://localhost:8080
NOMINATIM_TIMEOUT_SECONDS=5
# For public Nominatim, include a real operator contact and follow its usage policy.
NOMINATIM_USER_AGENT=EmergencyIQ/1.0
NOMINATIM_PUBLIC_MIN_INTERVAL_SECONDS=1
NOMINATIM_CACHE_TTL_SECONDS=86400
NOMINATIM_FAILURE_CACHE_TTL_SECONDS=60
MAP_TILE_URL=http://localhost:8081/tiles/{z}/{x}/{y}.png
SARVAM_API_KEY=replace_with_server_side_key
SARVAM_API_URL=https://api.sarvam.ai/speech-to-text
SARVAM_STT_MODEL=saaras:v2.5
SARVAM_TIMEOUT_SECONDS=60
OLLAMA_TIMEOUT_SECONDS=120
