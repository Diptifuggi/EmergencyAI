          "raw": "{\n  \"full_name\": \"Rahul Sharma\",\n  \"phone\": \"+919876543210\",\n  \"alternate_phone\": \"+919876543211\",\n  \"guardian_phone\": \"+919876543212\",\n  \"guardian_relation\": \"Parent\",\n  \"address\": \"Flat 402, Green Park Apartments, Indiranagar, Bengaluru\",\n  \"age\": 28,\n  \"blood_group\": \"O+\",\n  \"allergies\": \"Penicillin, Peanuts\",\n  \"medical_history\": \"Mild Asthma (uses inhaler)\",\n  \"medical_consent\": true\n}"
